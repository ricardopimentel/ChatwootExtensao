{
  "manifest_version": 3,
  "name": "Chatwoot Helper",
  "version": "2.0.0",
  "description": "Gerenciador avançado para Chatwoot: lembretes de conversas, envio de mensagens em massa via CSV, janelas flutuantes e relatórios.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chatwoot Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
